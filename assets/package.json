{
    "name": "@uhifadhi/roster-module",
    "version": "1.0.0",
    "description": "The roster module's Stimulus controllers.",
    "symfony": {
        "controllers": {
            "rotation": {
                "main": "controllers/rotation_controller.js",
                "name": "roster--rotation",
                "fetch": "eager",
                "enabled": true
            },
            "now-line": {
                "main": "controllers/now_line_controller.js",
                "name": "roster--now-line",
                "fetch": "eager",
                "enabled": true
            },
            "pattern-editor": {
                "main": "controllers/pattern_editor_controller.js",
                "name": "roster--pattern-editor",
                "fetch": "eager",
                "enabled": true
            },
            "station-table": {
                "main": "controllers/station_table_controller.js",
                "name": "roster--station-table",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0"
        }
    }
}
