{# ============================================================================
   TODAY — the agenda, ported from the design's modules/roster/today.html.

   THE PLAN AND THE MEASUREMENT SIDE BY SIDE AND NEVER MERGED. Each line
   carries the watch this module rostered AND the state the AREA derived from
   that person's own check-in and pings. The gap between the two is the point
   of the module; collapsing them into one verdict would throw it away.

   A HOLE IS ITS OWN LINE, not a missing one. A watch the pattern asked for
   and nobody is on is the thing somebody has to act on, so it is drawn
   rather than left as an absence the eye has to notice.

   The house card: `.c`, a `.tab`, a body, one quiet door.
   ========================================================================== #}
{% extends '@UhifadhiRoster/base.html.twig' %}

{% block title %}{{ area.name }} · Roster · today{% endblock %}

{% block shell_page_title %}Roster{% endblock %}

{% block shell_page_subtitle %}Who is due, and what the positions say about them. The watch is the roster&rsquo;s; the state beside it is the area&rsquo;s reading of a ranger&rsquo;s own check-in.{% endblock %}

{% block roster_trail_tail %} <a href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OVERVIEW_ROUTE'), {uuid: area.uuid}) }}">roster</a> / today{% endblock %}

{% block roster_page %}
    {{ include('@UhifadhiRoster/_identity_band.html.twig') }}

    <div class="c">
        <span class="tab">{{ isToday ? 'Today' : 'The day' }}<span class="src">&middot; <time datetime="{{ day.format('Y-m-d') }}" data-localtime-format="day">{{ day.format('D j M')|lower }}</time> &middot; {{ posts|length }} post{{ posts|length == 1 ? '' : 's' }} on the books</span></span>
        <a class="more" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::WEEK_ROUTE'), {uuid: area.uuid}) }}">The week &rarr;</a>

        {% for post in posts %}
            <div class="r-ag-post">
                <b>{{ post.stationName }}</b>
                <span class="sp"></span>
                <span class="r-st-state {{ post.state.value }}"><i></i>{{ post.state.label }}</span>
                {%- if post.expected %}<span class="unit">{{ post.rostered|length }} of {{ post.expected }}</span>{% endif %}
            </div>

            {% for person in post.rostered %}
                {# A DAY HOLDS ANY NUMBER OF WATCHES (ruled). Each one is its
                   own row and the name carries the day's total, because a
                   morning at the gate and an afternoon on an escort are two
                   facts and one row showing the latest would hide the first. #}
                {% for watch in person.watches %}
                    <div class="r-ag-line">
                        <span class="nm">
                            {{- loop.first ? person.personName : '' -}}
                            <em>
                                {{- person.shiftLabel|lower }}
                                {%- if person.watchCount > 1 %} &middot; watch {{ loop.index }} of {{ person.watchCount }}{% endif -%}
                                {%- if loop.first and person.watchCount > 1 %} &middot; {{ (person.minutesOnDuty // 60) }}h{% if person.minutesOnDuty % 60 %}{{ person.minutesOnDuty % 60 }}m{% endif %}{% if person.isStillOut %}, still out{% endif %}{% endif -%}
                            </em>
                        </span>
                        <span class="why">
                            {%- if watch.state.value == 'at_post_unverified' %}
                                {{ watch.unverifiedReason ? watch.unverifiedReason.label : 'unverified' }}
                                {%- if watch.distanceM is not null %} &mdash; {{ (watch.distanceM / 1000)|number_format(1) }} km from the post claimed{% endif %}
                            {%- elseif watch.statusLabel %}
                                {{ watch.statusLabel }}{% if watch.note %} &mdash; {{ watch.note }}{% endif %}
                            {%- else %}
                                {{ watch.pings }} position{{ watch.pings == 1 ? '' : 's' }} since the check-in
                            {%- endif %}
                            {%- if watch.notCheckedOut %} &middot; <b>not checked out</b>{% endif %}
                        </span>
                        <span class="r-ci {{ watch.state.value }}"><i></i>{{ watch.state.label }}</span>
                        {%- if watch.lastPingAt %}
                            <span class="unit"><time datetime="{{ watch.lastPingAt.format('c') }}" data-localtime-format="time">{{ watch.lastPingAt.format('H:i') }}</time></span>
                        {%- endif %}
                    </div>
                {% else %}
                    <div class="r-ag-line">
                        <span class="nm">{{ person.personName }}<em>{{ person.shiftLabel|lower }}</em></span>
                        <span class="why">nothing has arrived for this day</span>
                        <span class="r-ci no_check_in"><i></i>no check-in</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {% if post.shortfall %}
                <div class="r-ag-line hole">
                    <span class="nm">{{ post.shortfall }} unfilled<em>{{ post.rostered|length }} of {{ post.expected }}</em></span>
                    <span class="why">the pattern asked for {{ post.expected }} and nobody is on the rest</span>
                    <span class="r-ci no_check_in"><i></i>hole</span>
                </div>
            {% endif %}

            {% if post.rostered is empty and not post.shortfall %}
                <div class="r-ag-line">
                    <span class="nm"><span class="fog">nobody rostered</span></span>
                    <span class="why">this post asks for nobody today &mdash; reporting and unstaffed are different facts</span>
                </div>
            {% endif %}
        {% else %}
            <div class="rfrag"><b>No post is on the roster&rsquo;s books</b><em>a watch is given to a post deliberately, so none is assumed</em></div>
        {% endfor %}

        {% if not isToday %}
        {% endif %}
    </div>
{% endblock %}
