{# every boundary on one plate, bounded at card height like every
   other dashboard plate. The full one is the Live tab.

   THE PLATE IS THE ATLAS'S AND THE GROUND IS EACH AREA'S. This module
   contributes the marker layers and draws nothing itself. #}
<div class="c">
    <span class="tab">Every area, live<span class="src">&middot; {{ figures.checkedIn }} checked in</span></span>
    <a class="more" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterOrgController::LIVE_ROUTE')) }}">Live &rarr;</a>

    {% if plate is defined and plate %}
        <div>{{ render_map(plate, {"--map-plate-height": "300px"}) }}</div>
    {% else %}
        <div class="rfrag"><b>No area has a boundary to draw</b><em>a plate is the area&rsquo;s ground; without one there is nothing to put the positions on</em></div>
    {% endif %}
</div>
