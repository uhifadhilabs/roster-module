{# ============================================================================
   THE WEEK — the design's modules/roster/week.html, ported.

   THE HOUSE CARD, ruled 2026-09-20: `.c`, a `.tab` header carrying the title
   and its `.src` caption, a body, and at most ONE quiet `.more` door. No
   banded card on a tab — banding is for register and configure cards — and
   no footer strip: page actions live in the page header and row actions on
   the row.

   EVERY HOLE IS DRAWN AS A HOLE. That is the whole reason this tab exists:
   it is the only surface in the module where a missing watch is visible
   before the day arrives. A cell says what the post asked for beside what it
   got, so "N 1 of 2" is a hole and "N 2" is not.
   ========================================================================== #}
{% extends '@UhifadhiRoster/base.html.twig' %}

{% block title %}{{ area.name }} · Roster · week{% endblock %}

{% block shell_page_title %}Roster{% endblock %}

{% block shell_page_subtitle %}People down, days across, a fortnight. The planner&rsquo;s tab &mdash; a cell is the watch, today&rsquo;s column carries the live state, and a swap is two cells with a cost.{% endblock %}

{% block roster_trail_tail %} <a href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OVERVIEW_ROUTE'), {uuid: area.uuid}) }}">roster</a> / week{% endblock %}

{% block roster_page %}
    {{ include('@UhifadhiRoster/_identity_band.html.twig') }}

    {{ include('@UhifadhiRoster/today/_filters.html.twig', {
        area: area, day: from, isToday: false, filter: filter, posts: postsForFilter,
        chosenPost: chosenPost, stateLabels: stateLabels, stateCounts: stateCounts,
        shiftLabels: shiftLabels, shiftCounts: shiftCounts,
        here: constant('Uhifadhi\\Roster\\Controller\\RosterController::WEEK_ROUTE'),
    }, with_context: false) }}

    {# THE FOUR FIGURES, every one measuring the same fortnight the grid
       draws — a strip that counted a different window would be a strip
       nobody could check against the picture under it.

       FLAGGED TODAY IS NOT ONE OF THEM, and its absence is the point: this
       is the PLANNER's tab and a flag is today's problem, which the agenda
       and the day board both lead with. A fortnight's card that changed
       every morning would be the one thing on this page that is not about
       the fortnight. #}
    <div class="grid kstrip" style="margin-bottom:12px">
        <div class="c kpi hot" data-kpi="person-watches">
            <span class="tab">Person-watches</span>
            <b class="disp">{{ figures.personWatches }}<em>this fortnight</em></b>
            <span class="sub">from the {{ band.rangers }} posted at the {{ band.postsWithAWatch }}</span>
        </div>
        <div class="c kpi{{ figures.holes > 0 ? ' bad' : '' }}" data-kpi="holes">
            <span class="tab">Holes</span>
            <b class="disp">{{ figures.holes }}</b>
            <span class="sub">
                {%- if soonestGap %}<span class="r">soonest <time datetime="{{ soonestGap.day.format('Y-m-d') }}" data-localtime-format="day">{{ soonestGap.day.format('D j M')|lower }}</time> at {{ soonestGap.station }}</span>
                {%- else %}every watch the rings asked for is filled{% endif -%}
            </span>
        </div>
        <div class="c kpi" data-kpi="heaviest-nights">
            <span class="tab">Nights, the heaviest</span>
            <b class="disp">{{ figures.heaviestNights }}<em>of {{ days|length }}</em></b>
            <span class="sub">{{ figures.heaviestName ? figures.heaviestName ~ ' · the ring gives them the most' : 'nobody stands a night' }}</span>
        </div>
        <div class="c kpi" data-kpi="swaps-pending">
            <span class="tab">Swaps pending</span>
            <b class="disp">{{ figures.swapsPending }}</b>
            <span class="sub">{{ figures.swapsPending ? 'waiting on a handset' : 'nothing out' }}</span>
        </div>
    </div>

    <h2 class="zone">People down, days across &mdash; the fortnight</h2>
    <div class="c">
        <span class="tab">The rota<span class="src">&middot; <time datetime="{{ from.format('Y-m-d') }}" data-localtime-format="day">{{ from.format('D j')|lower }}</time> &ndash; <time datetime="{{ through.format('Y-m-d') }}" data-localtime-format="day">{{ through.format('D j M')|lower }}</time> &middot; {{ band.rangers }} ranger{{ band.rangers == 1 ? '' : 's' }} &middot; {{ days|length }} days</span></span>
        <a class="more" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterConfigureController::ROTATION_ROUTE'), {uuid: area.uuid}) }}">The rotation &rarr;</a>

        {% if groups is empty %}
            <div class="rfrag"><b>No post is on the roster&rsquo;s books</b><em>a watch is given to a post deliberately, so none is assumed</em></div>
        {% else %}
            {# A FORTNIGHT DOES NOT FIT A PHONE. It scrolls sideways inside
               its card rather than widening the page — the house's own
               answer for a table. #}
            <div style="overflow-x:auto">
                <table class="fg-rota">
                    <colgroup><col class="who"><col class="dy" span="{{ days|length }}"></colgroup>
                    <tr>
                        <th class="who">ranger</th>
                        {% for day in days %}
                            <th class="{{ day.format('Y-m-d') == today.format('Y-m-d') ? 'today ' : '' }}{{ day.format('N') == '6' ? 'sat' : '' }}">
                                <time datetime="{{ day.format('Y-m-d') }}" data-localtime-format="day">{{ day.format('D')|lower }}<em>{{ day.format('d') }}</em></time>
                            </th>
                        {% endfor %}
                    </tr>

                    {% for group in groups %}
                        <tr><td class="sep" colspan="{{ days|length + 1 }}">
                            <b>{{ group.stationName }}
                                {%- if group.stationCode %} <span class="mono">{{ group.stationCode }}</span>{% endif %}
                                <span class="mono">&middot; {{ group.asks }}</span></b>
                        </td></tr>

                        {% for row in group.rows %}
                            <tr>
                                <td class="who"><b>{{ row.personName }}</b><em>{{ row.nights }} night{{ row.nights == 1 ? '' : 's' }} &middot; {{ row.watches }} watch{{ row.watches == 1 ? '' : 'es' }}</em></td>
                                {% for day in days %}
                                    {% set cell = row.cells[day.format('Y-m-d')] %}
                                    <td class="{{ day.format('N') == '6' ? 'sat' : '' }}">
                                        <span class="fg-cell {{ cell.kind.value }}{{ cell.isToday ? ' now' : '' }}">
                                            {{- cell.label }}<em>{{ cell.note ?: cell.window }}</em>
                                            {%- if cell.isToday and cell.state %}<span class="live {{ cell.state.value }}">{{ cell.state.label }}</span>{% endif -%}
                                        </span>
                                    </td>
                                {% endfor %}
                            </tr>
                        {% else %}
                            <tr><td class="who fog">nobody in the ring</td><td class="fog" colspan="{{ days|length }}">this post is on the books and its rotation draws from nobody</td></tr>
                        {% endfor %}
                    {% endfor %}
                </table>
            </div>
        {% endif %}
    </div>

    <div style="height:12px"></div>

    {# THE HOLES, SOONEST FIRST — a BOUNDED list, so this card is the one that
       may carry a foot: latest N and a way to the rest. Ordered by when the
       watch STARTS and not by when the hole was noticed, because a hole three
       hours away outranks one next week however long it has been open. #}
    <div class="c">
        <span class="tab">Unfilled watches<span class="src">&middot; this fortnight &middot; {{ gaps|length }}</span></span>
        {% for gap in gaps|slice(0, 8) %}
            <div class="r-pres">
                <span class="nm">{{ gap.station }}<em><time datetime="{{ gap.day.format('Y-m-d') }}" data-localtime-format="day">{{ gap.day.format('D j M')|lower }}</time> &middot; {{ gap.label|lower }}</em></span>
                <span class="who">
                    {%- if gap.filled == 0 %}
                        the pattern asks for {{ gap.expected }}, nobody assigned
                    {%- else %}
                        the watch asks for {{ gap.expected }}, {{ gap.filled }} filled
                    {%- endif %}
                </span>
                <span class="cnt w">{{ gap.expected - gap.filled }} short</span>
            </div>
        {% else %}
            <div class="rfrag"><b>Nothing is short this fortnight</b><em>every watch the pattern asked for has somebody on it</em></div>
        {% endfor %}
        {% if gaps|length > 8 %}
            <div class="rfrag"><b>{{ gaps|length }} in total</b><em>the eight soonest are shown &mdash; a card never grows with its data</em></div>
        {% endif %}
    </div>

    <div style="height:12px"></div>

    {# ============================================================
       THE SWAP FLOW — two house cards, ruled 2026-09-20. The bordered
       bar the archive drew is not the product: a trade is a card that
       states the two cells and what they cost, and a register that
       shows every state an offer can end in.
       ============================================================ #}
    <div class="grid g2">

        <div class="c">
            <span class="tab">Swap a watch<span class="src">&middot; two cells, and what the trade costs</span></span>

            {% if offering %}
                <div class="rln"><span class="fog">Give up</span><span><b>{{ offering.duty.person.fullName }}</b> <span class="mono">{{ offering.duty.onDay.format('D j')|lower }} &middot; {{ offering.duty.station.name }} {{ offering.duty.shiftKey }}</span></span></div>
                <div class="rln"><span class="fog">Take it</span><span><b>{{ offering.taking.fullName }}</b> <span class="chip acc">picked</span></span></div>

                {% for check in cost.checks %}
                    <div class="rln"><span class="fog">{{ check.label }}</span><span class="mono {{ check.holds ? 'g' : 'w' }}">{{ check.detail }}</span></div>
                {% endfor %}

                {% if mayPlan %}
                    <form method="post" action="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OFFER_SWAP_ROUTE'), {uuid: area.uuid}) }}">
                        <input type="hidden" name="_token" value="{{ csrfToken }}">
                        <input type="hidden" name="duty" value="{{ offering.duty.uuid }}">
                        <input type="hidden" name="taking" value="{{ offering.taking.uuidString }}">
                        <div class="staddrow"><span class="sp"></span>
                            <a class="btn sm" href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::WEEK_ROUTE'), {uuid: area.uuid, from: from.format('Y-m-d')}) }}">Cancel</a>
                            <button type="submit" class="cta">Send the offer</button>
                        </div>
                    </form>
                {% endif %}
            {% else %}
                <div class="rln"><span class="fog">Give up</span><span class="fog">pick a watch from the grid above</span></div>
                <div class="rln"><span class="fog">Take it</span><span class="fog">then the person to ask</span></div>
                <div class="rfrag"><b>An offer moves nobody</b><em>until the handset accepts, both watches stand exactly as the rotation generated them</em></div>
            {% endif %}
        </div>

        <div class="c">
            <span class="tab">Swaps<span class="src">&middot; this fortnight &middot; latest {{ recent|length }}</span></span>

            {% for swap in recent %}
                <div class="rln">
                    <span><b>{{ swap.offeredTo.fullName }}</b> <span class="mono">
                        {{- swap.state.value == 'accepted' ? 'took' : (swap.state.value == 'offered' ? 'takes' : 'asked for') }}
                        {{ swap.duty.person.fullName }}&rsquo;s {{ swap.duty.onDay.format('D j')|lower }} {{ swap.duty.shiftKey }} at {{ swap.duty.station.name }}</span></span>
                    <span style="display:flex;align-items:center;gap:9px">
                        <span class="chip {{ {'offered': 'acc', 'accepted': 'ok', 'declined': 'fail', 'withdrawn': 'idle'}[swap.state.value] }}">{{ swap.state.label }}</span>
                        {%- if swap.respondedAt %}
                            <span class="mono d"><time datetime="{{ swap.respondedAt.format('c') }}" data-localtime-format="time">{{ swap.respondedAt.format('H:i') }}</time></span>
                        {%- endif %}
                    </span>
                </div>
            {% else %}
                <div class="rfrag"><b>No swap this fortnight</b><em>every watch is standing as the ring generated it</em></div>
            {% endfor %}
        </div>

    </div>
{% endblock %}
