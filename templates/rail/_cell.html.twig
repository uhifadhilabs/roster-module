{# THE HEAD OF ONE LIST IN THE RAIL: where it sits, what it is, and how many
   it holds.

   A LIST STATES ITS OWN COUNT, because the rail carries several and a
   reader scrolling the third has lost sight of how long the first was. The
   count is of the WHOLE list, not of the rows one sub-head happens to
   hold. #}
{# THE CELL'S OWN CONTROLS: where it sits, and the way out of the rail.
   They are real buttons in a real form, so composing the rail needs no
   JavaScript at all — the same reason the plan sheet's pills are labels. #}
<div class="rl-cellhd">
    <span class="ord">
        <b>{{ position }}</b>
        {% if mayCompose %}
            <button type="submit" form="rail-{{ id }}-up" {{ position == 1 ? 'disabled' : '' }} aria-label="Move {{ label }} up">&#9650;</button>
            <button type="submit" form="rail-{{ id }}-down" {{ position == total ? 'disabled' : '' }} aria-label="Move {{ label }} down">&#9660;</button>
        {% endif %}
    </span>
    <span class="k">{{ label }}</span>
    <em>{{ count }}</em>
    <span class="sp"></span>
    {% if mayCompose %}
        <button type="submit" form="rail-{{ id }}-remove" class="rm" title="Take {{ label }} out of the rail">&times;</button>
    {% endif %}
</div>
