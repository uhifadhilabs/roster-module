{# TODAY, EVERY AREA — the area agenda with one column added.

   WHICH AREA IS THAT COLUMN, and it is the only thing this scope adds: the
   rows are the areas' own, read from the same service the area page calls.

   THE FILTER BAR IS THE HOUSE'S GROUPED DROPDOWNS, three of them — area,
   state, shift — and it closes with what it is letting through, so a
   narrowed list never lies about how much it is hiding. #}
{% extends '@UhifadhiRoster/org/base.html.twig' %}

{% block title %}Roster · today · {{ scope.label }}{% endblock %}

{% block roster_org_page %}
    <div class="c">
        <span class="tab">Today, every area<span class="src">&middot; <time datetime="{{ day.format('Y-m-d') }}" data-localtime-format="day">{{ day.format('D j M')|lower }}</time> &middot; <time datetime="{{ now.format('c') }}" data-localtime-format="time">{{ now.format('H:i') }}</time></span></span>

        <div class="rfrag"><b>{{ figures.expected }} due &middot; {{ figures.checkedIn }} checked in &middot; {{ figures.needingADecision }} need an answer</b><em>across {{ areas|length }} area{{ areas|length == 1 ? '' : 's' }}, counted from each area&rsquo;s own reading</em></div>

        {% if rows is empty %}
            <div class="rfrag"><b>Nobody is due in any area today</b><em>a watch is given to a post deliberately, so an empty day is a real answer</em></div>
        {% else %}
            <table class="tbl">
                <tr><th>area</th><th>ranger</th><th>post</th><th>shift</th><th>state</th></tr>
                {% for row in rows %}
                    <tr>
                        <td><span class="orgarea sm" data-cat="{{ row.position }}"><i></i>{{ row.areaName }}</span></td>
                        <td><b>{{ row.person.personName }}</b></td>
                        <td>{{ row.post.stationName }}</td>
                        <td>{{ row.person.shiftLabel }}</td>
                        <td>{{ row.person.state.label }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% endif %}
    </div>
{% endblock %}
