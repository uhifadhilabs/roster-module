{# ============================================================================
   THE CALENDAR — one ranger's month, drawn in the HOUSE calendar.

   THE ATLAS OWNS THE MONTH. The grid, the day head, the cell, its fixed
   height, the day number, the "+N more" and the stepper all come from
   `atlas_calendar()`; this module ships no month grid of its own and says
   only what happened on which day. That is the whole bargain of the
   component, and the reason a busy week cannot make the month taller than a
   quiet one.

   A PAST DAY CARRIES WHAT THE CHECK-IN RECORDED AND A FUTURE DAY WHAT THE
   ROTATION PLANS. The two never wear the same mark: a stood watch is
   hollow — finished — and one still to come is open.
   ========================================================================== #}
{% extends '@UhifadhiRoster/base.html.twig' %}

{% block title %}{{ area.name }} · Roster · calendar{% endblock %}

{% block shell_page_title %}Roster{% endblock %}

{% block shell_page_subtitle %}One ranger&rsquo;s month &mdash; the same format the handset draws.{% endblock %}

{% block roster_trail_tail %} <a href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::OVERVIEW_ROUTE'), {uuid: area.uuid}) }}">roster</a> / calendar{% endblock %}

{% block roster_page %}
    {{ include('@UhifadhiRoster/_identity_band.html.twig') }}

    {% if chosen is null %}
        <div class="c">
            <span class="tab">The month</span>
            <div class="rfrag"><b>No rotation in this area draws from anybody yet</b><em>a month is one ranger&rsquo;s watches, and there is nobody in a pool to show one for</em></div>
        </div>
    {% else %}
        <div class="grid kstrip">
            <div class="c kpi hot" data-kpi="watches">
                <span class="tab">Watches this month</span>
                <b class="disp">{{ figures.watches }}<em>of {{ figures.daysInMonth }} days</em></b>
                <span class="sub">{{ figures.nights }} night{{ figures.nights == 1 ? '' : 's' }} &middot; {{ figures.days }} day{{ figures.days == 1 ? '' : 's' }}</span>
            </div>
            <div class="c kpi" data-kpi="verified">
                <span class="tab">Verified</span>
                <b class="disp">{{ figures.verified }}<em>of {{ figures.worked }} worked</em></b>
                <span class="sub">the pings agreed with the post</span>
            </div>
            <div class="c kpi{{ figures.unverified > 0 ? ' bad' : '' }}" data-kpi="unverified">
                <span class="tab">Unverified</span>
                <b class="disp">{{ figures.unverified }}</b>
                <span class="sub">{% if figures.unverified > 0 %}<span class="r">a claim the pings did not bear out</span>{% else %}every claim at a post was borne out{% endif %}</span>
            </div>
            <div class="c kpi" data-kpi="no-check-in">
                <span class="tab">No check-in</span>
                <b class="disp">{{ figures.noCheckIn }}</b>
                <span class="sub">{% if figures.noCheckIn > 0 %}<span class="r">a past watch nothing arrived for</span>{% else %}every past watch was reported{% endif %}</span>
            </div>
            <div class="c kpi" data-kpi="nights-in-a-row">
                <span class="tab">Nights in a row, most</span>
                <b class="disp">{{ figures.longestNightRun }}</b>
                <span class="sub">{% if figures.longestNightRun > 0 %}the longest run the ring produced{% else %}no night watch this month{% endif %}</span>
            </div>
        </div>

        <h2 class="zone">{{ chosen.name }} &mdash; {{ month.label|lower }}</h2>
        <div class="c">
            {# THE CAPTION CARRIES WHO, WHAT THEY ARE AND WHERE — the design's
               own fields. A month with only a name on it makes the reader
               check the picker to know whose it is. #}
            <span class="tab">The month<span class="src">&middot; {{ chosen.name }}{% if chosen.role %} &middot; {{ chosen.role }}{% endif %}{% if chosen.post %} &middot; {{ chosen.post }}{% endif %} &middot; {{ figures.watches }} watch{{ figures.watches == 1 ? '' : 'es' }} &middot; {{ figures.nights }} night{{ figures.nights == 1 ? '' : 's' }}</span></span>
            {% if chosen.postUrl %}<a class="more" href="{{ chosen.postUrl }}">The post &rarr;</a>{% endif %}

            {# THE RANGER PICKER — the house's grouped dropdown, which is a
               `<details>`: the browser opens it, and a panel rendered as a
               div is a panel rendered OPEN. Every option is a real link, so
               a chosen ranger is a url somebody can send.

               IT RIDES IN THE MONTH'S OWN NAV ROW, through the atlas's
               `controls` slot — one line, the stepper at the left and this
               at the right, as the design draws it. It had a row of its
               own until the slot landed. #}
            {% set rangerPicker %}
                <details class="i-dd">
                    <summary class="mchip i-ddt">
                        <span class="i-ddval">{{ chosen.name|lower }}{% if chosen.post %} &middot; {{ chosen.post|lower }}{% endif %}</span><span class="i-ddcaret">&#9662;</span>
                    </summary>
                    <div class="i-ddmenu" aria-label="Choose a ranger">
                        <span class="i-ddhead">ranger</span>
                        {% for person in people %}
                            <a class="i-ddopt{{ person.uuid == chosen.uuid ? ' on' : '' }}"
                               href="{{ path(constant('Uhifadhi\\Roster\\Controller\\RosterController::CALENDAR_ROUTE'), {uuid: area.uuid, ranger: person.uuid, month: month.year ~ '-' ~ '%02d'|format(month.month)}) }}"><span class="i-dot"></span><span class="i-ddopt-l">{{ person.name }}</span></a>
                        {% endfor %}
                    </div>
                </details>
            {% endset %}

            {# The feed is handed over by the controller rather than reached
               for as a global: a template that resolved a service would be a
               template with a container in it. #}
            {{ atlas_calendar(
                feed,
                month,
                scope,
                previousUrl: path(constant('Uhifadhi\\Roster\\Controller\\RosterController::CALENDAR_ROUTE'), {uuid: area.uuid, ranger: chosen.uuid, month: month.previous.year ~ '-' ~ '%02d'|format(month.previous.month)}),
                nextUrl: path(constant('Uhifadhi\\Roster\\Controller\\RosterController::CALENDAR_ROUTE'), {uuid: area.uuid, ranger: chosen.uuid, month: month.next.year ~ '-' ~ '%02d'|format(month.next.month)}),
                controls: rangerPicker
            ) }}
        </div>
    {% endif %}
{% endblock %}
